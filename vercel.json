{
"version": 2,
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/img/(.*)",
            "dest": "/public/img/$1"
        },
        {
            "src": "/(css|js|fonts|images)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_URL": "",
        "APP_KEY": "base64:GFawgNQC40zyraA2p+Y7aMa7mKvPbwL/yeharY1xQXw=", 
        "DB_CONNECTION": "mysql",
        "DB_HOST": "il5-7b.h.filess.io",
        "DB_PORT": "3307",
        "DB_DATABASE": "aylamotorbikerent_interestis",
        "DB_USERNAME": "aylamotorbikerent_interestis",
        "DB_PASSWORD": "2a840eea6c23e09350d28ec242c57bd45e2234e2",
        
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie"
    },
    "outputDirectory": "public"
